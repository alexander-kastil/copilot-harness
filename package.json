{
  "name": "copilot-harness",
  "displayName": "Copilot Harness",
  "description": "Harness engineering for GitHub Copilot: see how your agents, skills, instructions and prompts work together across sessions and repositories.",
  "version": "0.1.2",
  "publisher": "integrations-at",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0D1117",
    "theme": "dark"
  },
  "author": {
    "name": "Alexander Kastil",
    "url": "https://integrations.at/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexander-kastil/gh-copilot-harness"
  },
  "engines": {
    "vscode": "^1.119.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "copilot",
    "github copilot",
    "harness",
    "agents",
    "skills"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "copilotHarness.open",
        "title": "Copilot Harness: Open"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run webview",
    "webview": "tsc -p src/webview && node scripts/webview.mjs",
    "watch": "tsc -watch -p ./",
    "watch:webview": "node scripts/webview.mjs --watch",
    "test": "npm run compile && node --test \"out/test/unit/**/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.118.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1"
  }
}
